{
  "name": "__MSG_name__",
  "version": "1.0.0",
  "manifest_version": 3,
  "default_locale": "en",
  "description": "__MSG_description__",
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png" 
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["content.js"]
    }
  ]
}   